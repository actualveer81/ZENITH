{
  "name": "zenith",
  "productName": "ZENITH",
  "version": "4.1.0",
  "description": "ZENITH — Cognitive Performance Companion. Build Deep. Rise Daily.",
  "author": {
    "name": "VEER",
    "email": "ACTUALVEER81@gmail.com"
  },
  "main": "main.js",
  "private": true,

  "scripts": {
    "start":       "electron .",
    "dev":         "NODE_ENV=development electron .",
    "build":       "electron-builder --publish never",
    "build:win":   "electron-builder --win --publish never",
    "build:mac":   "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release":     "electron-builder --publish always"
  },

  "dependencies": {
    "electron-updater": "^6.1.0",
    "electron-log":     "^5.0.0"
  },

  "devDependencies": {
    "electron":         "^36.0.0",
    "electron-builder": "^25.1.8"
  },

  "build": {
    "appId":       "com.zenith.cognitive",
    "productName": "ZENITH",
    "copyright":   "Copyright © 2025 ZENITH",

    "directories": {
      "output":         "dist",
      "buildResources": "build-resources"
    },

    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!build-resources/**/*",
      "!*.md",
      "!**/*.map"
    ],

    "extraResources": [
      {
        "from":   "assets",
        "to":     "assets",
        "filter": ["**/*"]
      }
    ],

    "publish": {
      "provider": "github",
      "owner":    "actualveer81",
      "repo":     "zenith"
    },

    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64", "arm64"] },
        { "target": "portable", "arch": ["x64"]          }
      ],
      "icon":                    "assets/icons/favicon-512.png",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable":   false
    },

    "nsis": {
      "oneClick":                           false,
      "perMachine":                         false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut":              true,
      "createStartMenuShortcut":            true,
      "shortcutName":                       "ZENITH",
      "license":                            "LICENSE.txt",
      "installerIcon":                      "assets/icons/favicon-256.png",
      "uninstallerIcon":                    "assets/icons/favicon-256.png",
      "installerHeaderIcon":                "assets/icons/favicon-128.png"
    },

    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon":               "assets/icons/favicon-512.png",
      "category":           "public.app-category.productivity",
      "darkModeSupport":    true,
      "hardenedRuntime":    true,
      "gatekeeperAssess":   false,
      "entitlements":       "build-resources/entitlements.mac.plist",
      "entitlementsInherit":"build-resources/entitlements.mac.plist",
      "minimumSystemVersion": "12.0"
    },

    "dmg": {
      "title":      "ZENITH ${version}",
      "icon":       "assets/icons/favicon-512.png",
      "background": "build-resources/dmg-background.png",
      "window":     { "width": 540, "height": 380 },
      "contents": [
        { "x": 165, "y": 190, "type": "file" },
        { "x": 375, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },

    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] },
        { "target": "rpm",      "arch": ["x64"] }
      ],
      "icon":     "assets/icons/favicon-512.png",
      "category": "Office",
      "desktop": {
        "StartupWMClass": "zenith"
      }
    },

    "deb": {
      "depends": ["gconf2", "gconf-service", "libnotify4", "libxtst6", "libnss3"]
    }
  }
}
